# Copy to .env.local and fill in. .env.local is gitignored.
# Deployed values are set in the Vercel project settings (Production + Preview).

# ── Supabase ────────────────────────────────────────────────────────────
# Project: https://supabase.com/dashboard  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Bypasses Row-Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin ───────────────────────────────────────────────────────────────
# Single shared password for /admin. Choose your own value.
ADMIN_PASSWORD=
# Random signing key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Purchase / download flow ─────────────────────────────────────────────
# Stripe test-mode keys (dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend (resend.com) — onboarding@resend.dev works for testing with no domain setup
RESEND_API_KEY=
EMAIL_FROM="Bryt Vision Media <onboarding@resend.dev>"

# ── Added in later layers ───────────────────────────────────────────────
# CRON_SECRET=
