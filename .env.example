# Copy to .env.local and fill in. .env.local is gitignored.
# Deployed values are set in the Vercel project settings (Production + Preview).

# ── Supabase ────────────────────────────────────────────────────────────
# Project: https://supabase.com/dashboard  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Bypasses Row-Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

